{
  "name": "@luan.sh/pi-context-windows",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-context-windows"
  },
  "description": "Recoverable context windows, history, and working notes for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./sdk": "./src/sdk.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "dependencies": {
    "@luan.sh/pi-developer-messages": "workspace:*",
    "@luan.sh/pi-libactions": "workspace:*",
    "@luan.sh/pi-libtui": "workspace:*",
    "@luan.sh/pi-xsettings": "workspace:*"
  },
  "bundledDependencies": [
    "@luan.sh/pi-developer-messages",
    "@luan.sh/pi-libactions",
    "@luan.sh/pi-libtui",
    "@luan.sh/pi-xsettings"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.1",
    "@earendil-works/pi-ai": ">=0.87.1",
    "@earendil-works/pi-agent-core": ">=0.87.1",
    "@earendil-works/pi-tui": ">=0.87.1",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3",
    "typebox": "1.3.15"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  }
}
