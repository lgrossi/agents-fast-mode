{
  "name": "@luan.sh/pi-imagegen",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-imagegen"
  },
  "description": "Standalone Codex image generation with shared Pi tool rendering and Code Mode",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts",
      "./node_modules/@luan.sh/pi-libtui/src/extension.ts"
    ]
  },
  "dependencies": {
    "@howaboua/pi-codex-imagegen": "0.0.4",
    "@luan.sh/pi-libtui": "workspace:*"
  },
  "bundledDependencies": [
    "@luan.sh/pi-libtui"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.1",
    "typebox": "*",
    "@earendil-works/pi-ai": ">=0.87.1",
    "@earendil-works/pi-tui": ">=0.87.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3",
    "@earendil-works/pi-tui": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1"
  },
  "scripts": {
    "typecheck": "tsc --build"
  }
}
